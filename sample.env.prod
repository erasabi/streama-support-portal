NODE_ENV=production
STREAMA_ENDPOINT=
# Server library lookup from Docker. Use host nginx on port 80, not Streama :8080
# (Docker cannot reach host:8080 on this VM). Example: http://host.docker.internal
STREAMA_URL=
STREAMA_USERNAME=
STREAMA_PASSWORD=
API_ENDPOINT=
DB_HOST=
DB_SCHEMA=
DB_USER=
DB_PASSWORD=
ADMIN_SECRETS=
SUPERUSER_SECRETS=
# ubuntu login/sudo password for agents on this VM (do not commit a real .env)
DEPLOY_USER=ubuntu
DEPLOY_SUDO_PASSWORD=