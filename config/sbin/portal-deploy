#!/usr/bin/env bash
# Root-only. Rebuild/restart docker-compose from fleetctl's current release, then migrate.
# No arguments — sudoers matches this path with an empty argv.
set -euo pipefail
if [[ $# -ne 0 ]]; then
	echo "usage: portal-deploy" >&2
	exit 2
fi

ROOT="${PORTAL_ROOT:-/home/ubuntu/streama-support-portal}"
COMPOSE_DIR="${PORTAL_COMPOSE_DIR:-$ROOT/current}"
ENV_FILE="${PORTAL_ENV_FILE:-$ROOT/.env}"

if [[ ! -f "$ENV_FILE" ]]; then
	echo "portal-deploy: missing env file: $ENV_FILE" >&2
	exit 1
fi
if [[ ! -f "$COMPOSE_DIR/docker-compose.yml" ]]; then
	echo "portal-deploy: no docker-compose.yml in $COMPOSE_DIR" >&2
	exit 1
fi

# portal.service still uses WorkingDirectory=$ROOT; mirror fleetctl's current release there.
if [[ "$(readlink -f "$COMPOSE_DIR" 2>/dev/null || echo "$COMPOSE_DIR")" == "$(readlink -f "$ROOT/current" 2>/dev/null || true)" ]]; then
	echo "==> sync current release into $ROOT (legacy portal.service cwd)"
	rsync -a --no-owner --no-group \
		--exclude releases --exclude current \
		"$COMPOSE_DIR/" "$ROOT/"
	COMPOSE_DIR="$ROOT"
fi

echo "==> docker-compose build server client ($COMPOSE_DIR)"
cd "$COMPOSE_DIR"
/usr/local/bin/docker-compose --env-file "$ENV_FILE" build server client
echo "==> docker-compose up --force-recreate"
/usr/local/bin/docker-compose --env-file "$ENV_FILE" up -d --force-recreate

api_http_code() {
	curl -s -o /dev/null -w '%{http_code}' --max-time 3 "$1" || true
}

echo "==> waiting for API"
ok=0
for _ in $(seq 1 180); do
	code="$(api_http_code http://127.0.0.1:3000/agent/v1/jobs)"
	if [[ "$code" != "000" && -n "$code" ]]; then
		echo "==> API listening (HTTP ${code})"
		ok=1
		break
	fi
	sleep 3
done
if [[ "$ok" != 1 ]]; then
	echo "portal-deploy: API did not come up" >&2
	exit 1
fi

/usr/local/sbin/portal-migrate

echo "==> waiting for /requests/all after migrate"
ok=0
code=""
for _ in $(seq 1 30); do
	code="$(api_http_code http://127.0.0.1:3000/requests/all)"
	if [[ "$code" == "200" ]] && curl -sf --max-time 5 http://127.0.0.1:3000/requests/all | python3 -c "import sys,json; json.load(sys.stdin)" 2>/dev/null; then
		ok=1
		break
	fi
	sleep 2
done
if [[ "$ok" != 1 ]]; then
	echo "portal-deploy: /requests/all not healthy JSON (last HTTP ${code:-none})" >&2
	exit 1
fi

# Drop a stray compose project started from fleetctl's current/ (empty DB volume).
if /usr/local/bin/docker-compose --env-file "$ENV_FILE" -f "$ROOT/current/docker-compose.yml" ps -q 2>/dev/null | grep -q .; then
	echo "==> stopping legacy compose project in $ROOT/current"
	/usr/local/bin/docker-compose --env-file "$ENV_FILE" -f "$ROOT/current/docker-compose.yml" down || true
fi

echo "portal-deploy: done"
